{
	"schemaVersion": 1,
	"id": "bayonet",
	"version": "${version}",
	"name": "M9 Bayonet",
	"description": "Counter-Strike weapons, animations and sounds for the HugoSMP.net Halloween event.",
	"authors": [
		"andoraspalace"
	],
	"license": "GPL-3.0-or-later",
	"icon": "assets/bayonet/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.bayonet.BayonetClient"
		],
		"modmenu": [
			"com.bayonet.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"bayonet.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*"
	}
}
